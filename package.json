{
  "name": "saydaly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Saydaly (صيدلي) — pharmacy management system (POS, purchases, stock, accounts, reports) on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "node tests/dev-server.mjs 8787 ./local.sqlite",
    "deploy": "wrangler deploy",
    "test": "node --test tests/api.test.mjs",
    "db:backup": "wrangler d1 export pharmacy-db --remote --output=backup.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": { "node": ">=22" }
}
